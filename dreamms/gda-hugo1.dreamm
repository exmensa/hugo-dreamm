//
// Hugo's House of Horrors (Gray Design Associates 1989)
//
desc[gda-hugo1]:
name = Hugo's House of Horrors
icon = gda-hugo1.png
machine = pc
osenv = dos
mips = 0.8
videohw = ega
audiohw = sb16
rootpath = C:\Hugo
launch = $(rootpath)\HHH.EXE $(PARAMETER)

//
// filesystem
//
mount[]: vpath = $(rootpath); srcpath = $(ifsupgradepath); writable = true; condition = is_upgrader()
mount[]: vpath = C:\;		  srcpath = $(ifsdeltapath);   writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


//
// Mode selector
//
PARAMETER = $(NULL)
config[mode]:
	condition = file_exists("$$(rootpath)\\PLAYBACK.DAT")
	title = Mode
	option[play]:
		name = Game
		priority = 1
		end
	option[watch]:
		name = Automatic Playback
		PARAMETER = -p
		end
end


//
// Installer
//
script[init]:
	condition = is_installer()
    code = [[[$(CRLF)
			wait("int21", 8);
			keyboard_type("y");
    ]]]
end


