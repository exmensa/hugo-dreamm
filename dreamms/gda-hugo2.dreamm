//
// Hugo II: Whodunit? (Gray Design Associates 1991)
//
desc[gda-hugo2]:
name = Hugo II: Whodunit?
icon = gda-hugo2.png
machine = pc
osenv = dos
mips = $(MIPS_386SX_20)
nothrottle = 6
videohw = ega
audiohw = sb16
rootpath = C:\Hugo2
launch = $(rootpath)\HUGO.EXE $(PARAMETER)

//
// filesystem
//
mount[]: vpath = C:\;		  srcpath = $(ifsdeltapath);   writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


//
// Mode selector
//
PARAMETER = $(NULL)
config[mode]:
	condition = is_game()
	title = Mode
	option[play]:
		name = Sound Enabled
		priority = 1
		end
	option[silent]:
		name = Sound Disabled
		PARAMETER = -s
		end
	option[watch]:
	condition = file_exists("$$(rootpath)\\PLAYBACK.DAT")
		name = Automatic Playback
		PARAMETER = -p
		end
	option[watchsilent]:
	condition = file_exists("$$(rootpath)\\PLAYBACK.DAT")
		name = Automatic Playback, Sound Disabled
		PARAMETER = -p -s
		end
end


//
// Installer
//
script[init]:
	condition = is_installer()
    code = [[[$(CRLF)
			wait("int21", 8);
			keyboard_type("y");
    ]]]
end


// DOS shareware common files
fragment[dos-base]:
    file[]: crc = bc1c1818; size =    155240; name = OBJECTS.DAT
    file[]: crc = bc24a511; size =    527321; name = SCENERY.DAT
    file[]: crc = 35149794; size =     27299; name = STRINGS.DAT
    file[]: crc = 3518f506; size =     45936; name = TMSRB.FON
    file[]: name = FILE_ID.DIZ	; optional = true
    file[]: name = MANUAL.DOC	; optional = true
    file[]: name = README.DOC	; optional = true
end


// DOS 1.0S
demo[pc-1.0s]:
	name = DOS v1.0 Shareware
	anchorfile = HUGO.EXE
	imports = dos-base
    file[]: crc = 34740a57; size =      2213; name = HELP.DAT
    file[]: crc = e58f19d3; size =    115995; name = HUGO.EXE		// 1991-02-16 14:50
end


// DOS 1.0S installer
installer[pc-1.0s-inst]:
	name = DOS v1.0 Shareware Installer
	anchorfile = HUGO2.EXE
	launch = $(rootpath)\HUGO2.EXE
	installid = pc-1.0s
    file[]: crc = 513d0f23; size =    326863; name = HUGO2.EXE		// 1991-02-28
end


