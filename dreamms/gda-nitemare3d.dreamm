//
// Nitemare-3D (Gray Design Associates 1994)
//
desc[gda-nitemare3d]:
name = Nitemare-3D
icon = gda-nitemare3d.png
machine = pc
osenv = dos
audiohw = sb16
rootpath = C:\Nitemare
launch = "$(rootpath)\$(EXEC).exe" $(PARAMETER)
PARAMETER = $(NULL)

//
// filesystem
//
mount[]: vpath = $(rootpath);	srcpath = $(ifsupgradepath);	writable = true;	condition = is_upgrader()
mount[]: vpath = C:\;			srcpath = $(ifsdeltapath);		writable = true
mount[]: vpath = $(rootpath);	srcpath = $(ifsinstallpath)


//
// Mode selector
//
config[mode]:
	condition = is_game()
	title = Mode
	option[game]:
		name = Game
		launch = "$(rootpath)\$(EXEC).exe" $(PARAMETER)
		priority = 1
		end
	option[maps]:
		condition = is_windows()
		name = Map Viewer
		launch = "$(rootpath)\Maps.exe"
		end
	option[maps1]:
		condition = is_dos()
		name = Map Viewer - Episode 1
		launch = "$(rootpath)\Map.exe" -e 1
		end
	option[maps2]:
		condition = is_dos()
		name = Map Viewer - Episode 2
		launch = "$(rootpath)\Map.exe" -e 2
		end
	option[maps3]:
		condition = is_dos()
		name = Map Viewer - Episode 3
		launch = "$(rootpath)\Map.exe" -e 3
		end
end


//
// DOS Audio configuration
//
config[sound]:
	condition = is_dos()
	title = Audio Configuration
	option[none]:
		name = No sound or joystick
		audiohw = speaker
		PARAMETER = -s
		end
	option[pcs]:
		name = $(SPEAKER_NAME)
		audiohw = speaker
		PARAMETER = -p
		end
	option[adlib]:
		name = AdLib + PC Speaker
		audiohw = adlib
		PARAMETER = $(NULL)
		end
	option[sb16]:
		name = $(SB16_NAME)
		audiohw = sb16
		PARAMETER = $(NULL)
		priority = 1
		end
end

