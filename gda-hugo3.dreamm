//
// Hugo III: Jungle of Doom (Gray Design Associates 1992)
//
desc[gda-hugo3]:
name = Hugo III: Jungle of Doom
icon = gda-hugo3.png
machine = pc
osenv = dos
mips = 1.2
videohw = ega
audiohw = sb16
rootpath = C:\Hugo3
launch = $(rootpath)\HUGO.EXE

//
// filesystem
//
mount[]: vpath = C:\;			srcpath = $(ifsdeltapath);		writable = true
mount[]: vpath = $(rootpath);	srcpath = $(ifsinstallpath)


//
// Mode selector
//
config[mode]:
	condition = is_game()
	title = Mode
	option[game]:
		name = Game
		launch = "$(rootpath)\$(EXEC).exe" $(PARAMETER)
		priority = 1
		end
	option[maps]:
		name = Map Viewer
		launch = "$(rootpath)\$(EXEC).exe" $(PARAMETER)
		end
end

// Installer batch file
BATCH = [[[$(CRLF)
	H3_PART1.EXE
	H3_PART2.EXE
]]]

script[runbat]:
    code = [[[$(CRLF)
        file_save("$$(rootpath)\\Install.bat", "$$(BATCH)");
    ]]]
end


// DOS common files
fragment[dos-base]:
    file[]: crc = 39249882; size =      2270; name = HELP.DAT
    file[]: crc = f0476085; size =    136419; name = OBJECTS.DAT
    file[]: crc = 5b83b044; size =    484746; name = SCENERY1.DAT
    file[]: crc = 81a59aaa; size =    137029; name = SCENERY2.DAT
    file[]: crc = d03b8170; size =     22777; name = STRINGS.DAT
    file[]: crc = 3518f506; size =     45936; name = TMSRB.FON
end


//DOS 1.0 Shareware
demo[pc-1.0s]:
	name = DOS v1.0 Shareware
	anchorfile = HUGO.EXE
	imports = dos-base
    file[]: crc = 88639ca5; size =    109635; name = HUGO.EXE		// 1992-02-16
    file[]: crc = 25d50be0; size =     14904; name = MANUAL.DOC
    file[]: crc = 014dc8bf; size =     12489; name = README.DOC
    file[]: crc = c10809e1; size =     22740; name = STRINGS.DAT
end


// DOS 1.0S installer 1992-02-16
installer[pc-1.0s-inst]:
	name = DOS v1.0 Shareware Installer
	anchorfile = H3_PART2.EXE
	launch = $(rootpath)\Install.bat
	installid = pc-1.0s
    file[]: crc = 10975a5f; size =    220120; name = H3_PART1.EXE
    file[]: crc = 02216852; size =    304158; name = H3_PART2.EXE	; exactonly = true
end


//DOS 1.1 Shareware
