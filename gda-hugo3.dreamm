	name = DOS v1.1 Shareware
	anchorfile = HUGO.EXE
	imports = dos-base
    file[]: crc = 1395e0d0; size =    109645; name = HUGO.EXE		// 1992-04-05
    file[]: crc = df4e3d23; size =     14974; name = MANUAL.DOC
    file[]: crc = bd0777ec; size =     12570; name = README.DOC
end


